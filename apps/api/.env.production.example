# Production environment for the API (Render). Placeholders only — paste the
# real values straight into the Render dashboard's Environment Variables page
# for the service; never fill this file in and commit it (this repo is
# public). See docs/DEPLOY-FREE.md for the full walkthrough, and
# apps/api/.env.production.local (gitignored) for where the real values
# actually live on a machine that needs them, e.g. to run `pnpm db:seed`
# against production.
#
# The root .env.example documents every variable in detail; this file is
# just the production-specific subset and their production-appropriate shape.

NODE_ENV=production
# Render assigns this at runtime; API_PORT is the same setting's local-dev
# name and stays as a fallback. Safe to leave both here as a reminder.
PORT=4000
API_PORT=4000
NODE_VERSION=22

API_URL=https://your-domain.example
WEB_URL=https://your-domain.example
CORS_ORIGINS=https://your-domain.example,https://www.your-domain.example
COOKIE_DOMAIN=your-domain.example
COOKIE_SECURE=true
# Render puts one reverse proxy in front of the container.
TRUST_PROXY=true
API_DOCS_ENABLED=false

# MongoDB Atlas (or any replica-set-capable MongoDB). Must be a replica set —
# even a free-tier M0 one — for the app's multi-document transactions.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<db>?retryWrites=true&w=majority

# No Redis in this deployment: inline sends email in-process and needs none.
QUEUE_DRIVER=inline

# openssl rand -base64 48
JWT_SECRET=<random-secret-at-least-32-chars>

MAIL_DRIVER=smtp
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=<brevo-smtp-login>
SMTP_PASSWORD=<brevo-smtp-key>
MAIL_FROM_NAME=Your Lab Name
MAIL_FROM_ADDRESS=no-reply@your-domain.example

# Backblaze B2 (or any S3-compatible store) — required once the platform has
# no durable local disk (Render's filesystem is ephemeral).
STORAGE_DRIVER=s3
S3_ENDPOINT=https://s3.<region>.backblazeb2.com
S3_REGION=<region>
S3_BUCKET=<bucket-name>
S3_ACCESS_KEY_ID=<b2-application-key-id>
S3_SECRET_ACCESS_KEY=<b2-application-key>

# Left at test/placeholder until Stripe is actually wanted — the app boots
# and runs fully without it; the Pay button just reports "not configured".
STRIPE_MODE=test

# Used once, by `pnpm db:seed`, to create the first super-admin.
SEED_ADMIN_EMAIL=<admin-email>
SEED_ADMIN_PASSWORD=<a-strong-password>

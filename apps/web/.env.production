# Production build-time values for the Next.js app (apps/web).
#
# Next.js loads this file automatically for `next build` / `next start` — no
# extra flag needed. These two vars are NEXT_PUBLIC_*, so they are read only
# while `next build` runs and get baked into the client bundle (and, for
# NEXT_PUBLIC_API_URL, into the CSP's connect-src — see next.config.mjs and
# docs/runbook.md's "Production checklist"). They cannot be changed by
# editing the running server's environment; changing either needs a rebuild.
#
# Safe to commit: both are public origins, not secrets. Real secrets
# (JWT_SECRET, MONGODB_URI, Stripe/SMTP keys, ...) belong in the server's own
# environment / the root .env, never here.
#
# An explicit process environment variable of the same name (e.g. a
# --build-arg passed to docker/web.Dockerfile) always wins over this file.

NEXT_PUBLIC_API_URL=https://apex-dental-solution.com
NEXT_PUBLIC_SITE_URL=https://apex-dental-solution.com

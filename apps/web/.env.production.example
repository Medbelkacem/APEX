# Production environment for the web app (Vercel). Placeholders only — paste
# the real values into the Vercel dashboard's Environment Variables page for
# the project. See docs/DEPLOY-FREE.md for the full walkthrough.
#
# Do NOT set NEXT_PUBLIC_API_URL: apps/web/src/lib/api/client.ts already
# defaults to a relative, same-origin /api base in production, and
# next.config.mjs's rewrite (driven by API_ORIGIN below) proxies that to the
# real API origin server-side. Setting NEXT_PUBLIC_API_URL would bypass the
# proxy and point the browser straight at the API's own origin instead.

# The API's real address (e.g. a Render service URL) — server-only, never
# reaches the browser bundle.
API_ORIGIN=https://your-api.onrender.com

# Baked into the client bundle at build time: canonical URLs, sitemap,
# robots.txt, metadataBase.
NEXT_PUBLIC_SITE_URL=https://your-domain.example

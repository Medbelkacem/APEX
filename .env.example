# ─────────────────────────────────────────────────────────────
# Apex Digital Lab platform — environment template
# Copy to `.env` and fill in. NEVER commit the real .env.
# ─────────────────────────────────────────────────────────────

# App
NODE_ENV=development
API_PORT=4000
WEB_PORT=3000
API_URL=http://localhost:4000
WEB_URL=http://localhost:3000
# Comma-separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:3000

# Database (MongoDB)
# A single connection string is all the app needs. Transactions (case+history,
# invoice+line-items, reference numbering) require a replica set — the docker
# stack and `pnpm db:local` both provide a single-node one; directConnection
# reaches it without seedlist discovery.
MONGODB_URI=mongodb://localhost:27017/dental?directConnection=true
# Alternatively, leave MONGODB_URI unset and provide the parts individually:
# MONGO_HOST=localhost
# MONGO_PORT=27017
# MONGO_DB=dental
# MONGO_USER=
# MONGO_PASSWORD=
# MONGO_REPLICA_SET=

# Background jobs. QUEUE_DRIVER=redis uses BullMQ (needs Redis); =inline sends
# emails in-process with no Redis (convenient for local dev).
QUEUE_DRIVER=redis
REDIS_URL=redis://localhost:6379

# Auth / sessions
JWT_SECRET=change-me-in-production-please-use-a-long-random-string
# Access-token lifetime. Short: a signed JWT cannot be withdrawn, so logout and
# account changes take effect at the next refresh, not immediately.
JWT_ACCESS_TTL=900
# Absolute session ceiling — rotation never carries a session past this.
JWT_REFRESH_TTL=604800
# Idle timeout: a session with no refresh inside this window is over.
SESSION_IDLE_TTL=1800
# Grace period in which re-presenting a spent refresh token counts as a race
# (two tabs waking together) rather than as a stolen token. 0 disables it.
REFRESH_REUSE_LEEWAY=10
# Password reset / invitation token lifetime (seconds)
RESET_TOKEN_TTL=3600
# Argon2id cost (OWASP baseline: 19456 KiB / 2 passes / 1 lane).
# Legacy bcrypt hashes still verify, and are upgraded on next successful login.
ARGON2_MEMORY_COST=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1
# Login rate limiting
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_SECONDS=900

# Cookies
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false

# Stripe
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_MODE=test

# Email (SMTP / SendGrid)
MAIL_DRIVER=smtp
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
MAIL_FROM_NAME=Apex Digital Lab
# The laboratory's real sending domain is not known yet; `.example` is
# reserved by IANA, so this default can never reach a live mailbox.
MAIL_FROM_ADDRESS=no-reply@apex.example

# File storage
STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=../../storage
MAX_UPLOAD_MB=100
MAX_IMAGE_MB=10
MAX_DOCUMENT_MB=25
# S3-compatible (future; only used when STORAGE_DRIVER=s3)
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Platform defaults
DEFAULT_CURRENCY=USD
DEFAULT_TIMEZONE=UTC

# Seed data (first super-admin created by `pnpm db:seed`)
SEED_ADMIN_EMAIL=admin@apex.example
SEED_ADMIN_PASSWORD=ChangeMe123!
SEED_ADMIN_FIRST_NAME=Platform
SEED_ADMIN_LAST_NAME=Admin

# Observability
LOG_LEVEL=info
SENTRY_DSN=

# Frontend (Next.js public vars)
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx

# Frontend site URL (for metadata, sitemap, robots)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Public contact details shown on the marketing Contact page.
# Left blank on purpose — set the laboratory's real details here. Any value left
# empty is omitted from the page rather than filled with a placeholder.
LAB_ADDRESS=
LAB_PHONE=
LAB_EMAIL=
LAB_HOURS=

# Direct-contact channels for the marketing site. LAB_WHATSAPP drives the
# floating call button (digits only, with country code — e.g. 15551234567); with
# it unset the button falls back to dialling LAB_PHONE, and with neither set it
# is not rendered at all. The two social URLs are the footer icons, and follow
# the same rule: unset means the icon is omitted, never shown pointing nowhere.
LAB_WHATSAPP=
LAB_INSTAGRAM_URL=
LAB_FACEBOOK_URL=

# ─────────────────────────────────────────────────────────────
# Dental Laboratory Management Platform — environment template
# Copy to `.env` and fill in. NEVER commit the real .env.
# ─────────────────────────────────────────────────────────────

# App
NODE_ENV=development
API_PORT=4000
WEB_PORT=3000
API_URL=http://localhost:4000
WEB_URL=http://localhost:3000
# Comma-separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:3000

# Database (PostgreSQL)
DATABASE_URL=postgres://dental:dental@localhost:5432/dental
DB_HOST=localhost
DB_PORT=5432
DB_USER=dental
DB_PASSWORD=dental
DB_NAME=dental
DB_SSL=false

# Background jobs. QUEUE_DRIVER=redis uses BullMQ (needs Redis); =inline sends
# emails in-process with no Redis (convenient for local dev).
QUEUE_DRIVER=redis
REDIS_URL=redis://localhost:6379

# Auth / sessions
JWT_SECRET=change-me-in-production-please-use-a-long-random-string
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=604800
# Password reset / invitation token lifetime (seconds)
RESET_TOKEN_TTL=3600
# bcrypt cost factor (DRS: >= 12)
BCRYPT_COST=12
# Login rate limiting
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_SECONDS=900

# Cookies
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false

# Stripe
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_MODE=test

# Email (SMTP / SendGrid)
MAIL_DRIVER=smtp
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
MAIL_FROM_NAME=Dental Lab
MAIL_FROM_ADDRESS=no-reply@dental-lab.test

# File storage
STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=../../storage
MAX_UPLOAD_MB=100
MAX_IMAGE_MB=10
MAX_DOCUMENT_MB=25
# S3-compatible (future; only used when STORAGE_DRIVER=s3)
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Platform defaults
DEFAULT_CURRENCY=DZD
DEFAULT_TIMEZONE=UTC

# Seed data (first super-admin created by `pnpm db:seed`)
SEED_ADMIN_EMAIL=admin@dental-lab.test
SEED_ADMIN_PASSWORD=ChangeMe123!
SEED_ADMIN_FIRST_NAME=Platform
SEED_ADMIN_LAST_NAME=Admin

# Observability
LOG_LEVEL=info
SENTRY_DSN=

# Frontend (Next.js public vars)
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx

# Frontend site URL (for metadata, sitemap, robots)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Public contact details shown on the marketing Contact page.
# Left blank on purpose — set the laboratory's real details here. Any value left
# empty is omitted from the page rather than filled with a placeholder.
LAB_ADDRESS=
LAB_PHONE=
LAB_EMAIL=
LAB_HOURS=
